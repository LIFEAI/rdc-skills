[Unit]
Description=RDC Skills public stateless MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/srv/regen/rdc-skills
Environment=NODE_ENV=production
Environment=PORT=3110
ExecStart=/usr/bin/node /srv/regen/rdc-skills/bin/rdc-skills-mcp.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
