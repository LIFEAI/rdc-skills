{
  "name": "@lifeaitools/rdc-skills",
  "version": "0.34.1",
  "description": "RDC typed-agent dispatch skill suite for Claude Code - plan, build, review, overnight builds",
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "rdc",
    "skills",
    "ai-agents"
  ],
  "author": "LIFEAI",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LIFEAI/rdc-skills.git"
  },
  "claude": {
    "type": "plugin",
    "skills": "skills/",
    "guides": "guides/",
    "version": "0.10.0",
    "commands": "commands/"
  },
  "bin": {
    "rdc-skills-install": "scripts/install-rdc-skills.js",
    "rdc-skills-self-test": "scripts/self-test.mjs",
    "rdc-skills-mcp": "bin/rdc-skills-mcp.mjs",
    "rdc-solid-score": "scripts/solid-score.mjs",
    "rdc-clean-code-score": "scripts/clean-code-score.mjs",
    "rdc-package-metrics": "scripts/package-metrics-cli.mjs",
    "rdc-architecture-score": "scripts/architecture-score.mjs",
    "rdc-pattern-score": "scripts/pattern-score.mjs",
    "rdc-refactoring-score": "scripts/refactoring-score.mjs",
    "rdc-test-smell-score": "scripts/lib/test-smell-scoring.mjs",
    "rdc-duplication-score": "scripts/duplication-score.mjs"
  },
  "scripts": {
    "test:validator": "node --test tests/lib/*.test.mjs",
    "postinstall": "node scripts/postinstall.js",
    "install-rdc-skills": "node scripts/install-rdc-skills.js",
    "uninstall:win": "powershell -ExecutionPolicy Bypass -File scripts/uninstall.ps1",
    "uninstall:unix": "bash scripts/uninstall.sh",
    "validate": "node tests/validate-skills.js",
    "rdc-design": "node scripts/rdc-design-cli.mjs",
    "test:hooks": "node scripts/test-rdc-hooks.mjs",
    "test:truth-gate": "node tests/run-evidence-gate.test.mjs && node tests/work-item-exit-gate-l2.test.mjs && node tests/work-item-exit-gate-l3.test.mjs && node tests/require-work-item-on-commit.test.mjs && node tests/harness-gates.test.mjs",
    "test:acceptance": "node tests/acceptance.test.mjs && node tests/install-rdc-skills.test.mjs && node tests/help-surface.test.mjs && node tests/manifest-contract-fields.test.mjs && node tests/plugin-namespace-names.test.mjs && node tests/skill-test-matrix.test.mjs && node tests/completion-gate-supervisor-admission.test.mjs && node tests/curl-surface.test.mjs && node tests/clauth-plugin-postinstall.test.mjs",
    "acceptance": "node scripts/acceptance.mjs --changed",
    "test:mcp": "node tests/mcp.test.mjs",
    "test:mcp:remote": "node tests/mcp.test.mjs --remote",
    "test:curl-surface": "node tests/curl-surface.test.mjs",
    "test:curl-surface:remote": "node tests/curl-surface.test.mjs --remote",
    "test:channel-formatter": "node tests/channel-formatter.contract.test.mjs",
    "test:channel-formatter:remote": "node tests/channel-formatter.contract.test.mjs --remote",
    "test:brochure": "node tests/rdc-brochure.test.mjs",
    "mcp": "node bin/rdc-skills-mcp.mjs",
    "prepack": "node scripts/prepack.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "express": "^5.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "ts-morph": "^24.0.0",
    "web-tree-sitter": "^0.24.7",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  }
}
