{
  "manifest_version": 1,
  "skill": "rdc:refactor",
  "description": "Refactor preserves evidence and isolates all dispatched writers.",
  "fixture": {
    "prompt": "rdc:refactor hook-scope --takeover \"corrective consolidation\"",
